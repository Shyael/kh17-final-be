<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="mapper.grade">
	<!-- 강의 등록 시 학년 정보 표시 용  -->
	<select id="gradeList" resultType="GradeVO">
		select 
			grade_no,
			grade_level
		from grade
		order by grade_no asc
	</select>
</mapper>