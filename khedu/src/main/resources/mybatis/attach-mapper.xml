<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="mapper.attach">
	<!-- 첨부파일 번호 생성 -->
	<select id="sequence" resultType="int">
		select attach_seq.nextval from dual
	</select>
	
	<!-- 첨부파일 등록 -->
	<insert id="insert">
		insert into attach(
			attach_no,
			attach_name,
			attach_type,
			attach_size,
			attach_rename
		)
		values(
			#{attachNo},
			#{attachName},
			#{attachType},
			#{attachSize},
			#{attachRename}
		)
	</insert>
	
	<!-- 첨부파일 상세 -->
	<select id="selectOne" resultType="AttachDto">
		select *
		from attach
		where attach_no = #{attachNo}
	</select>

	<!-- 첨부파일 삭제 -->
	<delete id="delete">
		delete from attach
		where attach_no = #{attachNo}
	</delete>
</mapper>